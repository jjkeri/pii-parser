{
  "manifest_version": 3,
  "name": "PII Parser",
  "version": "1.0.0",
  "description": "Redact emails, phones, IPs, IDs and names from text. Runs 100% locally.",
  "permissions": ["contextMenus", "clipboardWrite", "activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
